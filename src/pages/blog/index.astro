---
import BaseLayout from "../../layouts/BaseLayout.astro";

// 記事を足したら、ここにも1行足す
const posts = [
  { href: "/blog/crypto-tax-calculation-not-working/", title: "仮想通貨の損益計算ができないときの原因と対処法" },
  { href: "/blog/cryptact-too-many-transactions/", title: "Cryptactで『取引件数が多すぎます』と表示されたときの対処法" },
  { href: "/blog/cryptact-csv-upload/", title: "Cryptact（クリプタクト）へのCSVアップロード方法" },
  { href: "/blog/csv-download-bitflyer/", title: "bitFlyerの取引履歴CSVのダウンロード方法" },
  { href: "/blog/csv-download-coincheck/", title: "Coincheckの取引履歴CSVのダウンロード方法" },
];
---

<BaseLayout title="記事一覧｜かなえるTools" description="かなえるToolsのツールの使い方や、関連する手続きを解説した記事の一覧です。" ogImage="/ogp/site.jpg">
  <h1>記事一覧</h1>
  <ul class="posts">
    {posts.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
  </ul>
</BaseLayout>

<style>
  .posts { line-height: 2.2; padding-left: 1.2em; }
</style>
