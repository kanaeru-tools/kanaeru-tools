---
import "../styles/global.css";
// ogImage はページごとの共有画像（public からのパス）。指定がなければ、これまでの画像を使う
const {
  title = "かなえるTools",
  description = "",
  ogImage = "/ogp/crypto-run_image_free_light.jpg",
} = Astro.props;
const site = Astro.site ?? new URL("https://kanaeru-tools.com");
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(ogImage, site).href;
---


<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="かなえるTools" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />

    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "かなえるTools",
        "alternateName": "Kanaeru Tools",
        "url": "https://kanaeru-tools.com/"
      }
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
  </head>

  <body>

    <!-- ヘッダー -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-logo">
          かなえるTools
          <span class="site-tagline">小さな業務を、ちゃんとかなえる</span>
        </a>

        <nav class="site-nav">
          <a href="/tools/shiwake-kessan/">仕訳帳から決算書</a>
          <a href="/tools/crypto-run/">仮想通貨CSV圧縮</a>
          <a href="/terms/">利用規約</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="main-inner">
        <slot />
      </div>
    </main>

    <!-- フッター -->
    <footer class="site-footer">
      <p>
        ツールの改善要望・対応してほしい取引所などがあればお気軽にご連絡ください。
      </p>
      <p>
        お問い合わせ：
        <a href="mailto:kanaeru.tools@gmail.com">
          kanaeru.tools@gmail.com
        </a>
      </p>
    </footer>


  </body>
</html>
